# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/NextFlick

# Upstash Redis (REST) - leave empty to use in-memory cache
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# OMDb API (get a key at https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your_omdb_api_key
OMDB_API_URL=http://www.omdbapi.com/

# CORS - comma-separated allowed origins (leave empty to allow all), e.g. https://nextflick.vercel.app
CORS_ORIGIN=

# Internet Archive (free public domain movies) - defaults work, override only for testing
ARCHIVE_BASE_URL=https://archive.org
ARCHIVE_COLLECTION=feature_films

# Extra free movie sources (all optional; Internet Archive works without them)
# YouTube Data API v3 key (https://console.cloud.google.com/apis/credentials).
# Leave empty to disable YouTube. Only Creative Commons full-length films are listed.
YOUTUBE_API_KEY=
# Comma-separated HTTPS PeerTube instances or search indexes (default: SepiaSearch,
# which indexes the federation). Set to an empty value to disable PeerTube.
PEERTUBE_INSTANCES=https://sepiasearch.org
